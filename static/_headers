# Cloudflare Workers static-assets headers (copied to build/_headers by Docusaurus).
# Docusaurus emits content-hashed filenames under /assets/ (main.<hash>.js, styles.<hash>.css,
# hashed images), so those bytes never change under the same URL — cache them for a year.
# HTML is deliberately NOT listed: it must stay max-age=0 so a deploy shows up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Agent-facing text files are served as text/plain, NOT text/markdown, and the
# .md extension stays: ChatGPT's web fetcher rejected prompt.md verbatim with
# "Unsupported content-type: text/markdown" while reading llms.txt (text/plain)
# fine — measured by the owner in ChatGPT on 2026-09-14 (card 15455d96). Earlier
# curl runs under six agent User-Agents proved only that this server doesn't
# discriminate by UA; they say nothing about what a fetcher's own content-type
# whitelist accepts. The charset must stay: these files carry non-ASCII.
# Rules are per path, no globs, so new files here don't inherit them silently.
/agent-setup/prompt.md
  Content-Type: text/plain; charset=utf-8
/agent-setup/guide.md
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/auth.md
  Content-Type: text/plain; charset=utf-8

# Agent discovery (Cloudflare Agent Readiness, ud task 5ac33489). The API catalog is
# RFC 9727: the file has no extension, so its type must be set here or the asset
# server guesses application/octet-stream. The homepage advertises it, the OpenAPI
# description and the agent-facing docs via RFC 8288 Link headers.
/.well-known/api-catalog
  Content-Type: application/linkset+json
/
  Link: </.well-known/api-catalog>; rel="api-catalog", </api/openapi.json>; rel="service-desc", </api/>; rel="service-doc", </llms.txt>; rel="describedby", </auth.md>; rel="describedby"
/zh-Hans/
  Link: </.well-known/api-catalog>; rel="api-catalog", </api/openapi.json>; rel="service-desc", </api/>; rel="service-doc", </llms.txt>; rel="describedby", </auth.md>; rel="describedby"
